# Copy to .env.local for local work. On Vercel add the same names under Project -> Settings -> Environment Variables.
# Never commit real values.

# Your live site address (used inside WhatsApp tracking links). Example: https://indira-naturals.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Admin (server). Paste the ENTIRE service-account JSON file contents as one value.
# Firebase Console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON=

# Who may open /admin (comma separated). They must also exist in Firebase Authentication (Email/Password).
ADMIN_EMAILS=bonthadileep1234@gmail.com

# Optional: secret used to sign customer tracking links (defaults to one derived from the service account)
# ORDER_LINK_SECRET=
